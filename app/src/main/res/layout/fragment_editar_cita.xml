<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF6FA"
    tools:context=".ui.editarcita.EditarCitaFragment">

    <!-- Criterio 1: Toolbar personalizada gris oscuro con esquinas inferiores curvadas -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbarEditar"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:background="@drawable/bg_toolbar_curva"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackEditar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver a detalle"
            android:src="@drawable/ic_arrow_back_pink"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTituloToolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar Cita"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarEditar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp">

            <!-- Criterio 2: Nombre de la mascota (max 15 caracteres) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNombreMascota"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nombre de la Mascota"
                app:boxStrokeColor="#6200EE"
                app:hintTextColor="#6200EE">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombreMascota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:maxLength="15"
                    android:singleLine="true"
                    android:textColor="#212121" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Criterio 3: Raza (AutoCompleteTextView) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRaza"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Raza"
                app:boxStrokeColor="#6200EE"
                app:hintTextColor="#6200EE">

                <AutoCompleteTextView
                    android:id="@+id/actvRaza"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:completionThreshold="2"
                    android:inputType="text"
                    android:padding="16dp"
                    android:singleLine="true"
                    android:textColor="#212121" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Criterio 4: Nombre del Propietario (max 30 caracteres) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPropietario"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Nombre del Propietario"
                app:boxStrokeColor="#6200EE"
                app:hintTextColor="#6200EE">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPropietario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:maxLength="30"
                    android:singleLine="true"
                    android:textColor="#212121" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Criterio 5: Teléfono (solo números, max 10 caracteres) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTelefono"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Teléfono"
                app:boxStrokeColor="#6200EE"
                app:hintTextColor="#6200EE">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="10"
                    android:singleLine="true"
                    android:textColor="#212121" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Indicador de carga mientras consulta API o Room -->
            <ProgressBar
                android:id="@+id/progressEditar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:visibility="gone" />

            <!-- Criterios 6 y 7: Botón Editar Cita -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEditarCita"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="48dp"
                android:background="@drawable/bg_btn_editar"
                android:drawableStart="@drawable/ic_edit_black"
                android:drawablePadding="8dp"
                android:enabled="false"
                android:paddingHorizontal="28dp"
                android:text="Editar Cita"
                android:textAllCaps="false"
                android:textColor="#4A2528"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>