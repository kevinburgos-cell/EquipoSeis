<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.univalle.dogapp.ui.login.LoginFragment">
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.univalle.dogapp.ui.home.HomeFragment">
        <action
            android:id="@+id/action_home_to_nueva_cita"
            app:destination="@id/nuevaCitaFragment" />
        <action
            android:id="@+id/action_home_to_detalle"
            app:destination="@id/detalleFragment" />
    </fragment>

    <fragment
        android:id="@+id/nuevaCitaFragment"
        android:name="com.univalle.dogapp.ui.nuevacita.NuevaCitaFragment">
        <action
            android:id="@+id/action_nueva_cita_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/detalleFragment"
        android:name="com.univalle.dogapp.ui.detalle.DetalleFragment">
        <argument android:name="citaId" app:argType="long" />
        <action
            android:id="@+id/action_detalle_to_home"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_detalle_to_editar_cita"
            app:destination="@id/editarCitaFragment" />
    </fragment>

    <fragment
        android:id="@+id/editarCitaFragment"
        android:name="com.univalle.dogapp.ui.editarcita.EditarCitaFragment">
        <argument android:name="citaId" app:argType="long" />
        <action
            android:id="@+id/action_editar_cita_to_detalle"
            app:destination="@id/detalleFragment" />
        <action
            android:id="@+id/action_editar_cita_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>